{
  "os": {
    "owner": "libs/platform/src/os/",
    "use": "qol_platform::Os (Os::current, Os::includes_current, Os::label, Os::build_target)",
    "names": ["linux", "macos", "windows"],
    "labels": ["Linux", "macOS", "Windows"],
    "allow": [
      { "path": "apps/tray/src/installer/platform/windows_rules/run_key.rs", "text": "Windows", "why": "the Software\\Microsoft\\Windows registry key" },
      { "path": "libs/apps/src/shell_link/tests.rs", "text": "Windows", "why": "the C:\\Windows folder inside a shell link fixture" },
      { "path": "plugins/cli-sessions/src/diagnostics/snapshot.rs", "text": "windows", "why": "the JSON key listing terminal windows" },
      { "path": "plugins/cli-sessions/tests/snapshot.rs", "text": "windows", "why": "the JSON key listing terminal windows" },
      { "path": "plugins/removeapp/src/core/platform/windows/mod.rs", "text": "Windows", "why": "the C:\\Windows folder" },
      { "path": "plugins/removeapp/src/core/platform/windows/catalog.rs", "text": "windows", "why": "a Start menu folder name" },
      { "path": "plugins/memory/src/verification/mod.rs", "text": "linux", "why": "a protected word in recalled text, beside android and freebsd" },
      { "path": "plugins/memory/src/verification/mod.rs", "text": "windows", "why": "a protected word in recalled text, beside android and freebsd" },
      { "path": "plugins/memory/src/verification/mod.rs", "text": "macos", "why": "a protected word in recalled text, beside android and freebsd" },
      { "path": "plugins/update-manager/src/updates/platform/linux/names.rs", "text": "linux", "why": "the Debian kernel source package name" }
    ]
  },
  "window chrome": {
    "owner": ["libs/gpui/src/popup_window/platform/", "libs/gpui/src/platform/"],
    "use": "a chrome entry point (configure_popup_window, configure_overlay_window, disable_window_shadow, ...) that the Surface calls for its SurfaceKind before the window shows",
    "calls": [
      "setHasShadow", "setStyleMask", "setCollectionBehavior", "setAnimationBehavior", "setOpaque",
      "setTitlebarAppearsTransparent", "setTitleVisibility", "setHidesOnDeactivate",
      "DwmSetWindowAttribute", "SetWindowLongPtrW", "override_redirect"
    ],
    "entry_points": [
      "configure_popup_window", "configure_overlay_window", "disable_window_shadow",
      "make_override_redirect", "set_override_redirect_by_title", "square_window_corners",
      "apply_tool_window_style", "join_all_spaces"
    ],
    "allow": [
      {
        "path": "libs/gpui/src/popup_window/platform/windows.rs",
        "text": "cloak",
        "why": "DWMWA_CLOAK hides and reveals the window without unmapping it; that is visibility, not chrome"
      },
      {
        "path": "libs/gpui/src/popup_window/platform/windows.rs",
        "text": "set_window_min_size_by_title",
        "why": "GWLP_WNDPROC chains a window procedure that raises WM_GETMINMAXINFO to the surface's minimum size; that is sizing, not chrome"
      }
    ]
  }
}
