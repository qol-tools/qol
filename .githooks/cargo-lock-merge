#!/usr/bin/env bash
# Git merge driver for Cargo.lock (activated by `/Cargo.lock merge=cargo-lock`).
# Cargo.lock is fully derived from the Cargo.toml manifests, so a "conflict" in it
# is never a real conflict - just two regenerations of derived data. Seed from one
# side, then re-derive the whole graph with cargo metadata against the
# already-merged manifests, so dependency edges that exist only on the other side
# survive the merge. A workspace-only `cargo update` is not enough here: it bumps
# member versions but never restores missing dependency edges, and during a
# rebase "ours" is the branch being replayed onto, so the incoming lock's edges
# would be silently lost.
#
# Invoked as: cargo-lock-merge %O %A %B %P
#   $2 (%A) is "ours" AND the file git takes as the merge RESULT.
set -u

ours="$2"
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
lock="$root/Cargo.lock"

cp -f "$ours" "$lock"

if command -v cargo >/dev/null 2>&1; then
  cargo metadata --manifest-path "$root/Cargo.toml" --format-version 1 --offline >/dev/null 2>&1 \
    || cargo metadata --manifest-path "$root/Cargo.toml" --format-version 1 >/dev/null 2>&1 \
    || cargo update --manifest-path "$root/Cargo.toml" --workspace --offline >/dev/null 2>&1 \
    || true
fi

cp -f "$lock" "$ours"
exit 0
