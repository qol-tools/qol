#!/usr/bin/env bash
# Fast pre-commit gates for the qol monorepo - mirror CI (.github/workflows/ci.yml).
# Registered by `qol setup`, which `qol dev` runs on every boot.
# These checks are fast and deterministic, so they always run before a commit.
# Compile/clippy/test stay out of the commit path - they run in `qol dev` and CI.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] && cd "$root" || exit 0

node "$root/.githooks/single-source-guard.mjs" || exit 1

staged_plugin_manifest=0
while IFS= read -r -d '' path; do
  case "$path" in
    plugins/*/plugin.toml|plugins/*/Cargo.toml|apps/*/Cargo.toml) staged_plugin_manifest=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$staged_plugin_manifest" = 1 ] && command -v python3 >/dev/null 2>&1; then
  if ! parity_error="$(python3 "$root/.github/scripts/plugin_version.py" --check-manifests 2>&1 >/dev/null)"; then
    printf '\n%s\n' "$parity_error" >&2
    printf '\n  pre-commit rejected: a release unit'"'"'s plugin.toml and Cargo.toml disagree\n' >&2
    printf '  fix    : set both to the same version, and Cargo.lock with them\n' >&2
    printf '  then re-stage the changes and commit again\n\n' >&2
    exit 1
  fi
fi

command -v cargo >/dev/null 2>&1 || exit 0

reject() {
  printf '\n  pre-commit rejected: %s\n' "$1" >&2
  printf '  fix    : %s\n' "$2" >&2
  printf '  then re-stage the changes and commit again\n\n' >&2
  exit 1
}

staged_rust=()
staged_manifest=0
while IFS= read -r -d '' path; do
  case "$path" in
    Cargo.lock|Cargo.toml|*/Cargo.toml) staged_manifest=1 ;;
  esac
  case "$path" in
    *.rs) [ -f "$path" ] && staged_rust+=("$path") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

edition="$(sed -nE 's/^edition = "([0-9]{4})".*/\1/p' "$root/Cargo.toml" | head -n1)"
[ -n "$edition" ] || edition=2021

if [ "${#staged_rust[@]}" -gt 0 ] && command -v rustfmt >/dev/null 2>&1; then
  if ! rustfmt --check --edition "$edition" "${staged_rust[@]}" >/dev/null 2>&1; then
    cargo fmt --all -- --check >/dev/null 2>&1 \
      || reject "rustfmt check failed" "cargo fmt --all"
  fi
fi

if [ "$staged_manifest" = 1 ]; then
  if ! lock_error="$(cargo metadata --locked --format-version 1 2>&1 >/dev/null)"; then
    printf '\n%s\n' "$lock_error" >&2
    reject "Cargo.lock does not match the workspace manifests" \
      "cargo metadata >/dev/null && git add Cargo.lock"
  fi

  if command -v cargo-hakari >/dev/null 2>&1; then
    if ! hakari_error="$(cargo hakari generate --diff 2>&1 >/dev/null)"; then
      printf '\n%s\n' "$hakari_error" >&2
      reject "libs/workspace-hack/Cargo.toml does not match the workspace manifests" \
        "cargo hakari generate && cargo hakari manage-deps --yes && git add libs/workspace-hack/Cargo.toml"
    fi
  fi
fi

exit 0
