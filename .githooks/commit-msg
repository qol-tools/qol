#!/usr/bin/env bash
# Conventional-commit + scope gate for the qol monorepo.
# Enable in a fresh clone with:  git config core.hooksPath .githooks
# Logic + edge cases live in commit-msg-lib.sh (unit-tested by commit-msg.test.sh).
set -u

here="$(cd "$(dirname "$0")" && pwd -P)"
. "$here/commit-msg-lib.sh"

msg_file="$1"
subject="$(head -n1 "$msg_file")"
body="$(cat "$msg_file")"

# Auto-generated / in-progress messages git itself produces.
case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "#"*) exit 0 ;;
esac

reject() {
  printf '\n  commit-msg rejected: %s\n' "$1" >&2
  printf '  subject: %s\n\n' "$subject" >&2
  printf '  format : <type>(scope?): imperative summary\n' >&2
  printf '  types  : %s\n' "${QOL_TYPES//|/ }" >&2
  if [ -n "${2:-}" ]; then
    printf '  scopes : %s\n' "$(printf '%s' "$2" | paste -sd' ' -)" >&2
  fi
  printf '\n' >&2
  exit 1
}

if ! reason="$(qol_check_body "$body")"; then
  reject "$reason"
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
allowed="$(qol_derive_scopes "$root")"

if ! reason="$(qol_check_subject "$subject" "$allowed")"; then
  reject "$reason" "$allowed"
fi

exit 0